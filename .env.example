# Copy to .env.local (gitignored) and fill in. See docs/DEVELOPMENT.md.

# Supabase. `npm run db:start` prints local values, which are not secrets.
# For the shared cloud dev project, ask Adrian privately; never paste keys in chat.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses Row-Level Security. Never prefix with NEXT_PUBLIC_ and
# never import it into client code. Unused until a design doc justifies it.
SUPABASE_SECRET_KEY=
