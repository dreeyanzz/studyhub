# Copy to .env.local (gitignored) and fill in. See docs/DEVELOPMENT.md.

# Supabase. `npm run db:start` prints local values, which are not secrets.
# For the shared cloud dev project, Adrian sends your .env.local privately (D-029,
# D-065); never paste keys in chat.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloud dev project only: the password of the shared test accounts, host@, host2@
# and seeker@example.test (D-028). Not read by the app. Locally, the accounts use
# the password in supabase/seed.sql instead.
CLOUD_DEV_ACCOUNT_PASSWORD=

# Cloud dev project only: the password of the shared Administrator account,
# admin@example.test (D-061, D-065). Not read by the app. Locally, the account uses
# the seed password instead.
CLOUD_DEV_ADMIN_PASSWORD=

# Server only. Bypasses Row-Level Security. Never prefix with NEXT_PUBLIC_ and
# never import it into client code. The cloud dev project's key only (D-065).
# `npm run db:accounts` uses it to promote the project's Administrator (D-061).
# Nothing else uses it until a design doc justifies it.
SUPABASE_SECRET_KEY=

# Stripe sandbox, test mode only (STORY-09, D-005, D-070). Server only: never
# NEXT_PUBLIC_. The secret key must start with sk_test_ or rk_test_; the app refuses
# a live key. Adrian shares it privately, like the cloud dev keys (D-065).
STRIPE_SECRET_KEY=
# The webhook's signing secret, whsec_. Locally, the one `stripe listen --print-secret`
# prints (see docs/DEVELOPMENT.md, "Testing payments locally"), or any value if you
# only use `npm run webhook:simulate`. On Vercel, the Dashboard endpoint's.
STRIPE_WEBHOOK_SECRET=
# Optional: point the Stripe calls at a stub. Unset, they go to https://api.stripe.com.
# STRIPE_API_URL=
