# Line endings: the repo stores LF everywhere, whatever core.autocrlf says on a
# teammate's machine. Hooks must be LF or Git's sh fails with "sh\r".
* text=auto eol=lf
*.ps1 text eol=crlf
.husky/* text eol=lf

# Binary files are never diffed or normalised.
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
